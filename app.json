{
  "expo": {
    "name": "La Martina Footgolf",
    "slug": "la-martina-footgolf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lamartinafootgolf",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.cambiame.lamartinafootgolf",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EBDB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cambiame.lamartinafootgolf"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "La Martina Footgolf",
      "shortName": "La Martina",
      "backgroundColor": "#F2EBDB",
      "themeColor": "#0A2014"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EBDB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
